{
  "name": "MoM Sovereign POSSE Stack DevContainer",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "version": "29.9.3",
      "mobyBuildxVersion": "0.38.2",
      "dockerDashComposeVersion": "5.7.0"
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1.3.2": {
      "version": "1.37.2",
      "helm": "4.3.1",
      "minikube": "none"
    },
    "ghcr.io/devcontainers-extra/features/opentofu:1.0.0": {
      "version": "1.13.9"
    },
    "ghcr.io/devcontainers/features/common-utils:2.7.1": {},
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {
      "version": "2.103.3"
    },
    "ghcr.io/devcontainers/features/python:1.8.1": {
      "version": "3.14.10",
      "installTools": false
    },
    "ghcr.io/devcontainers/features/node:2.1.2": {
      "version": "24.22.2",
      "npmVersion": "11.19.1",
      "pnpmVersion": "12.18.0"
    }
  },
  "postCreateCommand": "gh ext install devx-cafe/gh-insitu && gh insitu run post-create",
  "customizations": {
    "vscode": {
      "extensions": [
        "opentofu.vscode-opentofu",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml",
        "weaveworks.vscode-gitops-tools",
        "DavidAnson.vscode-markdownlint",
        "streetsidesoftware.code-spell-checker",
        "esbenp.prettier-vscode",
        "mhutchie.git-graph",
        "mk12.better-git-line-blame"
      ]
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME},target=/localhome,type=bind,consistency=cached"
  ],
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  }
}
